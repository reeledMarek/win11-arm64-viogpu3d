+BOOLEAN VioGpuAdapter::ResetFromTimeoutSync(void *opaque)
+{
+    VioGpuAdapter *adapter = static_cast<VioGpuAdapter *>(opaque);
+    BOOLEAN stagedAny = FALSE;
+
+    for (UINT node = 0; node < kMaxTrackedNodes; ++node)
+    {
+        for (UINT engine = 0; engine < kMaxTrackedEngines; ++engine)
+        {
+            VIOGPU_DMA_RETIREMENT_QUEUE *queue = &adapter->m_dmaRetirement[node][engine];
+            while (queue->Head)
+            {
+                VIOGPU_DMA_RETIREMENT *entry = queue->Head;
+                queue->Head = entry->Next;
+                entry->Next = NULL;
+                entry->Failed = 1;
+                entry->RetiredByReset = 1;
+                if (entry->Packet)
+                {
+                    PGPU_VBUFFER packet = static_cast<PGPU_VBUFFER>(entry->Packet);
+                    const UINT packetLen = entry->Length;
+                    entry->Packet = NULL;
+                    entry->Length = 0;
+                    adapter->CtrlStagePushFromIsr(packet, packetLen);
+                    stagedAny = TRUE;
+                }
+            }
+            queue->Tail = NULL;
+
+            InterlockedExchange(&adapter->m_preemptSubmittedOutstanding[node][engine], 0);
+            InterlockedExchange(&adapter->m_pendingPreemptionFence[node][engine], 0);
+            InterlockedExchange(&adapter->m_lastNotifiedFence[node][engine], 0);
+        }
+    }
+
+    if (stagedAny)
+    {
+        InterlockedOr((PLONG)&adapter->m_PendingWorks, ISR_REASON_DISPLAY);
+        adapter->m_DxgkInterface.DxgkCbQueueDpc(adapter->m_DxgkInterface.DeviceHandle);
+    }
+
+    return TRUE;
+}
+
+NTSTATUS VioGpuAdapter::ResetFromTimeout(VOID)
+{
+    DbgPrint(TRACE_LEVEL_WARNING, ("---> %s draining pending DMA retirement state\n", __FUNCTION__));
+
+    if (IsHardwareInit())
+    {
+        // Do not call virtio_device_reset here: QEMU 10's virtio-gpu-gl-device
+        // retains blob QOM properties across device resets and aborts if new
+        // blobs reuse IDs. Drain/detach KMD tracking safely and keep the
+        // host virgl/Venus device intact.
+        ExecuteSynchronized(ResetFromTimeoutSync, this);
+    }
+
+    DbgPrint(TRACE_LEVEL_WARNING, ("<--- %s\n", __FUNCTION__));
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS VioGpuAdapter::RestartFromTimeout(VOID)
+{
+    DbgPrint(TRACE_LEVEL_WARNING, ("<---> %s\n", __FUNCTION__));
+    return STATUS_SUCCESS;
+}
