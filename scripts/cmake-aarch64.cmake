get_filename_component(_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER "${_REPO_ROOT}/toolchain/llvm-mingw/bin/aarch64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${_REPO_ROOT}/toolchain/llvm-mingw/bin/aarch64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${_REPO_ROOT}/toolchain/llvm-mingw/bin/aarch64-w64-mingw32-windres")
set(CMAKE_ASM_COMPILER "${_REPO_ROOT}/toolchain/llvm-mingw/bin/aarch64-w64-mingw32-clang")
set(CMAKE_AR "${_REPO_ROOT}/toolchain/llvm-mingw/bin/llvm-ar")
set(CMAKE_RANLIB "${_REPO_ROOT}/toolchain/llvm-mingw/bin/llvm-ranlib")
set(CMAKE_FIND_ROOT_PATH "${_REPO_ROOT}/toolchain/llvm-mingw/aarch64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
